{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "cleanUrls": true,
  "trailingSlash": false,
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "SAMEORIGIN"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=()"
        }
      ]
    },
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ],
  "redirects": [
    {
      "source": "/pricing",
      "destination": "https://www.reveri.com/pricing",
      "permanent": false
    },
    {
      "source": "/science",
      "destination": "https://www.reveri.com/science",
      "permanent": false
    },
    {
      "source": "/app",
      "destination": "https://www.reveri.com/app",
      "permanent": false
    },
    {
      "source": "/about",
      "destination": "https://www.reveri.com/about",
      "permanent": false
    },
    {
      "source": "/media",
      "destination": "https://www.reveri.com/media",
      "permanent": false
    },
    {
      "source": "/press",
      "destination": "https://www.reveri.com/press",
      "permanent": false
    },
    {
      "source": "/careers",
      "destination": "https://www.reveri.com/careers",
      "permanent": false
    },
    {
      "source": "/faq",
      "destination": "https://www.reveri.com/faq",
      "permanent": false
    },
    {
      "source": "/terms",
      "destination": "https://www.reveri.com/terms",
      "permanent": false
    },
    {
      "source": "/privacy",
      "destination": "https://www.reveri.com/privacy",
      "permanent": false
    },
    {
      "source": "/knowledge",
      "destination": "https://www.reveri.com/knowledge",
      "permanent": false
    },
    {
      "source": "/knowledge/:slug*",
      "destination": "https://www.reveri.com/knowledge/:slug*",
      "permanent": false
    }
  ]
}
