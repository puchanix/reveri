{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "cleanUrls": true,
  "trailingSlash": true,

  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "X-Frame-Options", "value": "SAMEORIGIN" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        { "key": "Permissions-Policy", "value": "camera=(), microphone=(), geolocation=(), interest-cohort=()" },
        { "key": "Strict-Transport-Security", "value": "max-age=63072000; includeSubDomains; preload" }
      ]
    },
    {
      "source": "/assets/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    }
  ],

  "redirects": [
    { "source": "/membership", "destination": "/pricing/", "permanent": true },

    { "source": "/research", "destination": "/science/", "permanent": true },
    { "source": "/brain-activity-during-hypnosis", "destination": "/science/", "permanent": true },
    { "source": "/safety-of-hypnosis", "destination": "/science/#safety", "permanent": true },
    { "source": "/hypnosis-vs-placebo", "destination": "/science/", "permanent": true },
    { "source": "/genes", "destination": "/science/", "permanent": true },

    { "source": "/download", "destination": "/app/", "permanent": true },
    { "source": "/contact", "destination": "/support/", "permanent": true },
    { "source": "/frequently-asked-questions", "destination": "/pricing/#faq", "permanent": true },
    { "source": "/terms-of-service", "destination": "/terms/", "permanent": true },
    { "source": "/privacy-policy", "destination": "/privacy/", "permanent": true },

    { "source": "/hypnotizability", "destination": "https://app.reveri.com/hypno-test", "permanent": true },
    { "source": "/hypnotizability-test", "destination": "https://app.reveri.com/hypno-test", "permanent": true },

    { "source": "/hypnosis-stress-anxiety", "destination": "/", "permanent": false },
    { "source": "/hypnosis-good-sleep-insomnia", "destination": "/", "permanent": false },
    { "source": "/hypnosis-quit-smoking", "destination": "/", "permanent": false },
    { "source": "/quit-vaping", "destination": "/", "permanent": false },
    { "source": "/hypnosis-focus-performance", "destination": "/", "permanent": false },
    { "source": "/hypnosis-intuitive-eating", "destination": "/", "permanent": false }
  ]
}
